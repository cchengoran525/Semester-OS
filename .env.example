# Planka integration (optional — app runs fully without these)
# Base URL, e.g. https://planka.example.com  (no trailing slash needed)
VITE_PLANKA_URL=
# API token: Planka → 个人设置 → API 令牌
VITE_PLANKA_TOKEN=
# Board to sync with (needed for pull/push; probe works without it)
VITE_PLANKA_BOARD_ID=
# Target list for pushed tasks (defaults to the board's first list)
VITE_PLANKA_LIST_ID=

# NOTE: the AI assistant is NOT configured here — its Base URL / API Key /
# model are entered in-app (设置 → AI 助手) and stored in local IndexedDB,
# so the key never ends up in the build output.

# 服务器同步快捷按钮（可选）。设置页"用开发服务器代理 / 直连局域网服务器"
# 会读取这些值做填充；不配置时按钮只填代理地址、沿用已保存的令牌。
# 敏感值（令牌、内网地址）放 .env.local（已被 gitignore），不要写进仓库。
VITE_SYNC_TOKEN=
VITE_SYNC_DIRECT_URL=

# 新设备首次启动的默认同步地址（可选）
VITE_DEFAULT_SYNC_URL=

# 开发代理的快照服务器地址（vite.config 读取 process.env， 放 .env.local 即可）
# SNAPSHOT_TARGET=http://localhost:8787
